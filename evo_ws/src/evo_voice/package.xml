<?xml version="1.0"?>
<package format="3">
  <name>evo_voice</name>
  <version>0.1.0</version>
  <description>Evo-Botics speech-to-text, intent detection, and queued text-to-speech nodes.</description>
  <maintainer email="evobotics@example.com">Evo-Botics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>evo_reception_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-faster-whisper</exec_depend>
  <exec_depend>python3-speechrecognition</exec_depend>
  <exec_depend>python3-pyaudio</exec_depend>
  <exec_depend>piper-tts</exec_depend>
  <exec_depend>mpv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
