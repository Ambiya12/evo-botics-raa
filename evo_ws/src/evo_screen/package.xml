<?xml version="1.0"?>
<package format="3">
  <name>evo_screen</name>
  <version>0.1.0</version>
  <description>Affiche la page web /kiosk en plein écran (chromium) sur le LCD du robot.</description>
  <maintainer email="evobotics@example.com">Evo-Botics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <!-- chromium-browser est une dépendance système runtime (présent sur le Jetson). -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
