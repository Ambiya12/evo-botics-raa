{
  "name": "evo-botics-simulation",
  "dockerComposeFile": [
    "../ops/compose/compose.simulation.yml"
  ],
  "service": "vnc-gui",
  "workspaceFolder": "/workspace",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "bash -lc 'source /opt/ros/humble/setup.bash && cd /workspace && mkdir -p evo_ws/src bags maps'"
}
